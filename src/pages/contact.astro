---
import Layout from '../layouts/Layout.astro';
---
<Layout editorial title="Brand Partnerships & Creator Enquiries | Forge" description="Contact Forge about creator management or a brand partnership. Share your brand, campaign idea and timing, or enquire about website and SEO services.">
 <section class="forge-wrap forge-page-intro"><p class="forge-kicker">Forge / Contact</p><h1>A good conversation<br /><span class="editorial">starts here.</span></h1><p>Brand partnership, creator management or a digital project. Tell us what you have in mind.</p></section>
 <section class="forge-wrap forge-section forge-rule forge-enquiry" id="brand-enquiry"><div><p class="forge-kicker">For brands</p><h2>Share<br /><span class="editorial">your brief.</span></h2><p style="margin:24px 0">A few details help us understand the project. You can also email Michael directly.</p><a class="forge-link" href="mailto:michael@forge-co.ca?subject=Brand%20partnership%20enquiry">michael@forge-co.ca ↗</a></div><div><label for="brand-name">Brand or company</label><input id="brand-name" name="brand" autocomplete="organization" maxlength="120" /><label for="brand-project">What do you have in mind?</label><textarea id="brand-project" name="project" maxlength="2000" placeholder="Campaign idea, creator, content or deliverables"></textarea><label for="brand-timing">Timing <span style="font-weight:400">(optional)</span></label><input id="brand-timing" name="timing" maxlength="120" placeholder="For example, a launch month or date range" /><p class="hint">This local preview prepares an email draft. It does not send or store your details.</p><p id="brief-error" class="forge-enquiry-error" role="alert" hidden>Add your brand and a short project description.</p><button id="preview-brief" type="button" class="forge-button" style="margin-top:24px">Review email draft ↗</button><div id="brief-preview" class="forge-enquiry-output" aria-live="polite" hidden><h3>Your draft</h3><pre id="brief-text"></pre><a id="brief-email" class="forge-link" href="mailto:michael@forge-co.ca">Open in your email app ↗</a><p class="hint">You review and send the message in your email app.</p></div></div></section>
 <section class="forge-quiet"><div class="forge-wrap forge-section forge-pair"><article id="creator-enquiry"><p class="forge-kicker">For creators</p><h2>Your content.<br /><span class="editorial">Your next step.</span></h2><p style="margin:24px 0">Introduce yourself, share your public profile links and tell us what you are looking for from creator management.</p><a class="forge-link" href="mailto:michael@forge-co.ca?subject=Creator%20management%20enquiry">Email about creator management ↗</a></article><article><p class="forge-kicker">Digital services</p><h2>Websites,<br /><span class="editorial">SEO & more.</span></h2><p style="margin:24px 0">Looking for support with your website or search presence? Our existing digital services remain available.</p><a class="forge-link" href="/services/">Explore digital services ↗</a><br /><a class="forge-link" href="/growth-audit/">Existing growth-audit enquiry →</a></article></div></section>
 <script>
  const brand = document.querySelector<HTMLInputElement>('#brand-name');
  const project = document.querySelector<HTMLTextAreaElement>('#brand-project');
  const timing = document.querySelector<HTMLInputElement>('#brand-timing');
  if (new URLSearchParams(location.search).get('creator') === 'jayden-aj' && project) project.value = 'A brand partnership with Jayden AJ: ';
  document.querySelector('#preview-brief')?.addEventListener('click', () => {
    const error = document.querySelector<HTMLElement>('#brief-error');
    const valid = Boolean(brand?.value.trim() && project?.value.trim());
    if (error) error.hidden = valid;
    if (!valid) { (!brand?.value.trim() ? brand : project)?.focus(); return; }
    const body = `Brand: ${brand!.value.trim()}\n\nProject: ${project!.value.trim()}\n\nTiming: ${timing?.value.trim() || 'To discuss'}`;
    const text = document.querySelector('#brief-text'); if (text) text.textContent = body;
    const email = document.querySelector<HTMLAnchorElement>('#brief-email'); if (email) email.href = `mailto:michael@forge-co.ca?subject=${encodeURIComponent('Brand partnership enquiry — '+brand!.value.trim())}&body=${encodeURIComponent(body)}`;
    const preview = document.querySelector<HTMLElement>('#brief-preview'); if (preview) preview.hidden = false;
  });
 </script>
</Layout>
