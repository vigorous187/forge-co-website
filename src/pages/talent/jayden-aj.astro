---
import Layout from '../../layouts/Layout.astro';
import DragonPearlCampaign from '../../components/DragonPearlCampaign.astro';
const socials = [{label:'TikTok · @jaydenaj',href:'https://www.tiktok.com/@jaydenaj'},{label:'Instagram · @jaydenaj',href:'https://www.instagram.com/jaydenaj'},{label:'YouTube · @JaydenAj13',href:'https://www.youtube.com/@JaydenAj13'}];
const schema = [{'@context':'https://schema.org','@type':'ProfilePage',name:'Jayden AJ — Creator Profile',url:'https://forge-co.ca/talent/jayden-aj/',mainEntity:{'@type':'Person',name:'Jayden AJ',description:'Toronto lifestyle, beauty and food creator.',sameAs:socials.map(s=>s.href)}}];
---
<Layout editorial title="Jayden AJ — Lifestyle, Beauty & Food Creator | Forge" description="Meet Jayden AJ, a Toronto lifestyle, beauty and food creator. Explore his public channels and contact Forge about a brand partnership." schema={schema} ogImage="/assets/talent/jayden-burberry-portrait.jpg">
 <section class="forge-wrap forge-profile-hero"><div><a class="forge-link" href="/talent/">← All talent</a><p class="forge-kicker" style="margin-top:40px">Toronto / Creator profile</p><h1>Jayden <span class="editorial">AJ.</span></h1><p class="forge-tags">Lifestyle · Beauty · Food</p><p style="margin-top:28px;max-width:440px">Jayden AJ is a Toronto lifestyle, beauty and food creator. Explore his public content below and speak with Forge about a potential collaboration.</p><div class="forge-actions"><a class="forge-button" href="/contact/?creator=jayden-aj#brand-enquiry">Enquire about Jayden ↗</a></div></div><img src="/assets/talent/jayden-burberry-portrait.jpg" alt="Jayden AJ, studio portrait against a warm brown backdrop" width="900" height="1200" fetchpriority="high" /></section>
 <section class="forge-wrap forge-section forge-rule"><div class="forge-section-head"><p class="forge-kicker">Explore his content</p><div><h2>Get to know<br /><span class="editorial">Jayden.</span></h2><div class="forge-socials">{socials.map(s=><a class="forge-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><p>View current posts and profile information directly on each platform.</p></div></div><div class="forge-portraits"><img src="/assets/talent/jayden-alo-cyan.jpg" alt="Jayden AJ against a cyan studio backdrop" width="900" height="1200" loading="lazy" /><img src="/assets/talent/jayden-burberry-fullbody.jpg" alt="Jayden AJ, full-length studio portrait" width="900" height="1200" loading="lazy" /></div></section>
 <DragonPearlCampaign />
 <section class="forge-quiet"><div class="forge-wrap forge-section forge-section-head"><p class="forge-kicker">Brand partnerships</p><div><h2>Have a collaboration<br /><span class="editorial">in mind?</span></h2><p style="margin:24px 0;max-width:520px">Share the brand, your campaign idea and timing. Ask about relevant work examples, deliverables and availability for your brief.</p><a class="forge-button" href="/contact/?creator=jayden-aj#brand-enquiry">Start the conversation ↗</a></div></div></section>
</Layout>
