---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const email = path === '/contact' ? 'hello@forge-co.ca' : 'michael@forge-co.ca';
---
<footer class="forge-footer">
  <div class="forge-footer-top"><div><a href="/" class="forge-wordmark">FORGE<span>co.</span></a><p>Creator management. Brand partnerships.<br />Based in Toronto.</p></div>
  <nav aria-label="Footer navigation"><a href="/talent/">Talent</a><a href="/contact/">Contact</a><a href="/about/">About</a><a href="/services/">Digital services</a><a href="/blog/">Insights</a><a href="/case-studies/">Client work</a></nav></div>
  <div class="forge-footer-bottom"><span>© {new Date().getFullYear()} Forge Growth Co.</span><a href={`mailto:${email}`}>{email}</a><div><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></div></div>
</footer>
